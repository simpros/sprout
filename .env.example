# Gateway process env for local `bun run dev` (host network).
# Do not use this file with docker compose — see compose.env.example.

# Preview Postgres admin connection (CREATE/DROP DATABASE for preview DBs)
# Publish Postgres to the host, or point at any reachable instance.
PB_PREVIEW_POSTGRES_URL=postgres://admin:secret@localhost:5432/postgres

# Static credentials injected into preview app/seed containers (v0.1)
PB_PG_HOST=localhost
PB_PG_PORT=5432
PB_PG_USER=pb_preview
PB_PG_PASSWORD=change-me-preview

# Docker networks (must match network names on the host)
PB_TRAEFIK_NETWORK=traefik
PB_POSTGRES_NETWORK=postgres

# Container registry (pull preview app images; empty user/password = anonymous)
PB_REGISTRY_URL=registry.example.com
PB_REGISTRY_USER=puller
PB_REGISTRY_PASSWORD=

# Sweep (forge API). Token may be blank at boot; required when sweep calls the forge.
PB_FORGE=github
PB_FORGE_TOKEN=

# Optional tuning (defaults shown)
PB_STATE_DB_PATH=preview-buddy.db
# Operator bootstrap admin token (SHA-256 hash stored in SQLite). Omit, blank,
# or comment out to auto-generate on first start (token logged once).
# PB_ADMIN_TOKEN=
PB_TTL_HOURS=72
PB_SWEEP_MINUTES=30
PB_PREVIEW_PORT_DEFAULT=8080
PB_SEED_TIMEOUT=180
PB_PORT=7331
