# Gateway process env for local `bun run dev` (host network).
# Do not use this file with docker compose — see compose.env.example.

# Preview Postgres admin connection (role ensure + CREATE/DROP DATABASE).
# Needs CREATEROLE (or superuser). Gateway ensures SPROUT_PG_USER on boot.
# Publish Postgres to the host, or point at any reachable instance.
SPROUT_PREVIEW_POSTGRES_URL=postgres://admin:secret@localhost:5432/postgres

# Static credentials injected into preview app/seed containers (v0.1)
SPROUT_PG_HOST=localhost
SPROUT_PG_PORT=5432
SPROUT_PG_USER=sprout_preview
SPROUT_PG_PASSWORD=change-me-preview

# Docker networks (must match network names on the host)
SPROUT_TRAEFIK_NETWORK=traefik
SPROUT_POSTGRES_NETWORK=postgres

# Traefik TLS labels (optional; empty = HTTP-only, no tls/entrypoints labels).
# Set ENTRYPOINTS to enable HTTPS routers; CERTRESOLVER is optional with that.
# SPROUT_TRAEFIK_ENTRYPOINTS=https
# SPROUT_TRAEFIK_CERTRESOLVER=letsencrypt

# Traefik forwardAuth (optional SSO). Both required together or both empty.
# MIDDLEWARES is a single Traefik middleware name (no commas).
# SPROUT_TRAEFIK_MIDDLEWARES=voidauth
# SPROUT_FORWARDAUTH_ADDRESS=https://auth.example.com/api/authz/forward-auth

# Registry pull credentials. Empty = anonymous.
# Prefer per-host map when app/seed images span registries:
# SPROUT_REGISTRY_AUTHS_JSON={"ghcr.io":{"username":"u","password":"p"},"registry.gitlab.com":{"username":"u2","password":"p2"}}
# Legacy single-registry fallback (used when image host is not in the map):
SPROUT_REGISTRY_USER=puller
SPROUT_REGISTRY_PASSWORD=
SPROUT_REGISTRY_AUTHS_JSON=

# Sweep forge PATs (optional at boot; set before sweep runs).
# Kind is inferred per repo from the canonical URL (github.com / gitlab.com).
SPROUT_GITHUB_TOKEN=
SPROUT_GITLAB_TOKEN=
# Optional self-managed GitLab hosts: host=gitlab,host=...
# SPROUT_FORGE_HOSTS=

# Optional tuning (defaults shown)
SPROUT_STATE_DB_PATH=sprout.db
# Raw bootstrap admin bearer file for local CLI fallback (default: admin-token).
# SPROUT_ADMIN_TOKEN_PATH=admin-token
# Operator bootstrap admin token (SHA-256 hash stored in SQLite). Omit, blank,
# or comment out to auto-generate on first start (token logged once).
# SPROUT_ADMIN_TOKEN=
SPROUT_TTL_HOURS=72
SPROUT_SWEEP_MINUTES=30
SPROUT_PREVIEW_PORT_DEFAULT=8080
SPROUT_SEED_TIMEOUT=180
SPROUT_PORT=7331
