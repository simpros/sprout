# Compose project env — NOT the gateway process .env.
#   cp compose.env.example compose.env
#   docker compose --env-file compose.env up -d --build
# Do not copy this to `.env` (that file is for `bun run dev` via `.env.example`).

# Postgres image bootstrap (must match the admin DSN below)
POSTGRES_USER=pb_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=postgres

# Canonical admin DSN for the gateway (URL-encode special chars in the password).
# Keep user/password/db in sync with POSTGRES_* above.
SPROUT_PREVIEW_POSTGRES_URL=postgres://pb_admin:change-me-admin@postgres:5432/postgres

# Hostname/port preview app+seed containers use for PGHOST/PGPORT on SPROUT_POSTGRES_NETWORK.
# Bundled stack: leave as postgres. External Postgres: set to that service's DNS name.
SPROUT_PG_HOST=postgres
SPROUT_PG_PORT=5432

# Static preview credentials injected into app/seed containers (v0.1 spec)
SPROUT_PG_USER=pb_preview
SPROUT_PG_PASSWORD=change-me-preview

# Docker network names (single source for compose `name:` and gateway env).
# Opaque durable identity — keep preview-buddy-* across the package rename.
SPROUT_TRAEFIK_NETWORK=preview-buddy-traefik
SPROUT_POSTGRES_NETWORK=preview-buddy-postgres

# Optional: pin control-plane SQLite (default /data/preview-buddy.db)
# SPROUT_STATE_DB_PATH=/data/preview-buddy.db

# Host ports published by compose (override for e2e — see e2e/compose.e2e.env)
SPROUT_GATEWAY_HOST_PORT=7331
TRAEFIK_HTTP_PORT=8880

# Container registry for pulling preview app images (empty user/password = anonymous)
SPROUT_REGISTRY_URL=ghcr.io
SPROUT_REGISTRY_USER=
SPROUT_REGISTRY_PASSWORD=

# Operator bootstrap token — omit, comment out, or leave blank to auto-generate
# SPROUT_ADMIN_TOKEN=

# Forge API for sweep (GitHub or gitlab). Token may be blank at boot; set before sweep runs.
SPROUT_FORGE=github
SPROUT_FORGE_TOKEN=
