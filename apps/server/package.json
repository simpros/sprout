    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@sprout/preview-env": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
