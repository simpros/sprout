{
  "name": "@sprout/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api-type": "./src/http/api-type.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
