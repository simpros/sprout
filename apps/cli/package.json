{
  "name": "@sprout/cli",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "bin": {
    "sprout": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile:linux-x64": "mkdir -p ../../dist && bun build --compile --target=bun-linux-x64 --define SPROUT_CLI_VERSION=\\\"${SPROUT_CLI_VERSION:-dev}\\\" --outfile ../../dist/sprout-linux-x64 ./src/index.ts",
    "compile:linux-x64-musl": "mkdir -p ../../dist && bun build --compile --target=bun-linux-x64-musl --define SPROUT_CLI_VERSION=\\\"${SPROUT_CLI_VERSION:-dev}\\\" --outfile ../../dist/sprout-linux-x64-musl ./src/index.ts",
    "compile": "bun run compile:linux-x64 && bun run compile:linux-x64-musl",
    "compile:check-assets": "bash ./scripts/check-compile-assets.sh",
    "test": "bun test"
  },
  "dependencies": {
    "@sprout/api-client": "workspace:*",
    "@sprout/preview-db": "workspace:*",
    "@sprout/preview-env": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "^5.9.3"
  }
}
