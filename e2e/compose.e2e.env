# Fixed secrets for the e2e compose project only — safe to commit.
# Used by: bun run test:e2e (parse + docker compose --env-file). See e2e/README.md.

POSTGRES_USER=sprout_admin
POSTGRES_PASSWORD=e2e-admin-password
POSTGRES_DB=postgres

SPROUT_PREVIEW_POSTGRES_URL=postgres://sprout_admin:e2e-admin-password@postgres:5432/postgres

SPROUT_PG_HOST=postgres
SPROUT_PG_PORT=5432
SPROUT_PG_USER=sprout_preview
SPROUT_PG_PASSWORD=e2e-preview-password

# Isolated networks so e2e does not collide with a local smoke stack
SPROUT_TRAEFIK_NETWORK=sprout-e2e-traefik
SPROUT_POSTGRES_NETWORK=sprout-e2e-postgres

# Deterministic admin token for harness assertions
SPROUT_ADMIN_TOKEN=e2e-admin-token

SPROUT_GITHUB_TOKEN=
SPROUT_GITLAB_TOKEN=

# Host port mappings (read by docker-compose.yml; avoid colliding with smoke stack)
SPROUT_GATEWAY_HOST_PORT=17331
TRAEFIK_HTTP_PORT=18880
