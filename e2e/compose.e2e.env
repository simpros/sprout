# Fixed secrets for the e2e compose project only — safe to commit.
# Used by: bun run test:e2e (parse + docker compose --env-file). See e2e/README.md.

POSTGRES_USER=pb_admin
POSTGRES_PASSWORD=e2e-admin-password
POSTGRES_DB=postgres

PB_PREVIEW_POSTGRES_URL=postgres://pb_admin:e2e-admin-password@postgres:5432/postgres

PB_PG_HOST=postgres
PB_PG_PORT=5432
PB_PG_USER=pb_preview
PB_PG_PASSWORD=e2e-preview-password

# Isolated networks so e2e does not collide with a local smoke stack
PB_TRAEFIK_NETWORK=sprout-e2e-traefik
PB_POSTGRES_NETWORK=sprout-e2e-postgres

PB_REGISTRY_URL=ghcr.io
PB_REGISTRY_USER=
PB_REGISTRY_PASSWORD=

# Deterministic admin token for harness assertions
PB_ADMIN_TOKEN=e2e-admin-token

PB_FORGE=github
PB_FORGE_TOKEN=

# Host port mappings (read by docker-compose.yml; avoid colliding with smoke stack)
PB_GATEWAY_HOST_PORT=17331
TRAEFIK_HTTP_PORT=18880
