{
  "name": "sprout",
  "version": "0.8.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@sprout/server",
    "build": "turbo build && bun run docs:check",
    "docs:check": "bun run docs/site/check.ts",
    "docs:typecheck": "tsc --noEmit -p docs/site/tsconfig.json",
    "scripts:typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "docs:assemble": "bun run docs/site/assemble.ts",
    "docs:preview": "bun run docs/site/preview.ts",
    "test": "turbo test && bun run test:guards",
    "test:guards": "bun test docs/site/ deploy/ scripts/ templates/ ./.github/workflows/",
    "typecheck": "turbo build && bun run docs:check && bun run docs:typecheck && bun run scripts:typecheck",
    "test:e2e": "bun run e2e/run.ts",
    "sprout": "bun run apps/cli/src/index.ts",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:studio": "bun run --cwd apps/server db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "@tanstack/markdown": "0.0.13",
    "@types/bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
