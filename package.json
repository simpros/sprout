{
  "name": "sprout",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@sprout/server",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo build",
    "test:e2e": "bun run e2e/run.ts",
    "pbuddy": "bun run apps/cli/src/index.ts",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:studio": "bun run --cwd apps/server db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.0"
}
